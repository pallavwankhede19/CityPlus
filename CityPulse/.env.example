# CityPulse Environment Template
# Copy this to .env and fill in your keys

# --- Google Maps Platform ---
GOOGLE_MAPS_API_KEY=your_google_cloud_api_key_here

# --- AI & Voice Keys ---
SARVAM_API_KEY=your_sarvam_ai_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Network Config ---
# Replace with your machine's local IP for mobile connectivity
BACKEND_URL=http://your_ip:3000/api
SOCKET_URL=http://your_ip:3000
TTS_URL=http://your_ip:5001
VOICE_WS_URL=ws://your_ip:5001/ws/voice
