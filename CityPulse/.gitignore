# ------------------------------------------
# METHOD 1: EXPLICIT EXACT PATHING
# ------------------------------------------
/.env
/server/.env
/mobile/.env
/voice_gateway/.env
/mobile/android/local.properties
/mobile/android/key.properties
/mobile/ios/Runner/secret.plist

# ------------------------------------------
# METHOD 2: THE WILDCARD "CATCH-ALL"
# ------------------------------------------
**/.env
**/.env.*
**/local.properties
**/*.keystore
**/auth_key.json

# ------------------------------------------
# JUNK CACHE & BUILD FOLDERS
# ------------------------------------------
**/node_modules/
**/build/
**/.dart_tool/
**/.pub-cache/
**/__pycache__/

# ------------------------------------------
# HUGE ASSETS
# ------------------------------------------
**/shared/models/*.pt
**/shared/models/*.onnx
**/*.wav
**/*.mp4
