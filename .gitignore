# ==========================================
# 🛡️ CITYPULSE MASTER SECURITY GIT-IGNORE
# ==========================================

# ------------------------------------------
# METHOD 1: EXPLICIT EXACT PATHING
# (Targeting exactly where we know the files are)
# ------------------------------------------
/CityPulse/.env
/CityPulse/server/.env
/CityPulse/mobile/.env
/CityPulse/voice_gateway/.env
/CityPulse/mobile/android/local.properties
/CityPulse/mobile/android/key.properties
/CityPulse/mobile/ios/Runner/secret.plist

# ------------------------------------------
# METHOD 2: THE WILDCARD "CATCH-ALL"
# (A backup net just in case files move around)
# ------------------------------------------
**/.env
**/.env.*
**/local.properties
**/*.keystore
**/auth_key.json

# ------------------------------------------
# JUNK CACHE & BUILD FOLDERS
# ------------------------------------------
**/node_modules/
**/build/
**/.dart_tool/
**/.pub-cache/
**/__pycache__/

# ------------------------------------------
# HUGE ASSETS (To prevent Git from crashing)
# ------------------------------------------
**/shared/models/*.pt
**/shared/models/*.onnx
**/*.wav
**/*.mp4
